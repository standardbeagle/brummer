package redux

import (
	"fmt"
	"os"
	"time"

	"github.com/charmbracelet/bubbletea"
	"github.com/standardbeagle/brummer/internal/tui_redux/commands"
	"github.com/standardbeagle/brummer/internal/tui_redux/messages"
	"github.com/standardbeagle/brummer/internal/tui_redux/model"
	"github.com/standardbeagle/brummer/internal/tui_redux/update"
	"github.com/standardbeagle/brummer/internal/tui_redux/views"
)

// Program wraps the BubbleTea program with Redux/Elm architecture
type Program struct {
	program *tea.Program
	model   *model.Model
}

// NewProgram creates a new Redux/Elm TUI program
func NewProgram(options ...tea.ProgramOption) *Program {
	// Initialize the model with default state
	m := model.NewModel()

	// Create initial commands
	initialCmd := tea.Batch(
		commands.LoadSettings(""),
		commands.Tick(1*time.Second),
	)

	// Set initial state
	if initialCmd != nil {
		m.SetInitializing(false)
	}

	// Create BubbleTea program with Redux architecture
	p := tea.NewProgram(m, append(options, tea.WithAltScreen())...)

	return &Program{
		program: p,
		model:   m,
	}
}

// Run starts the TUI program
func (p *Program) Run() error {
	return p.program.Run()
}

// Release returns the underlying model for testing
func (p *Program) Release() *model.Model {
	return p.model
}

// App represents the main application with Redux/Elm architecture
type App struct {
	model  *model.Model
	program *tea.Program
}

// NewApp creates a new application instance
func NewApp() *App {
	m := model.NewModel()

	// Initialize with startup commands
	cmds := tea.Batch(
		commands.LoadSettings(""),
		func() tea.Msg {
			return messages.StatusUpdateMsg{
				Message: "Redux/Elm TUI initialized",
				Level:   "info",
			}
		},
	)

	// Set up the program with custom options
	opts := []tea.ProgramOption{
		tea.WithAltScreen(),
		tea.WithMouseCellMotion(),
		tea.WithInput(os.Stdin),
		tea.WithOutput(os.Stdout),
	}

	program := tea.NewProgram(m, opts...)

	return &App{
		model:   &m,
		program: program,
	}
}

// Run starts the application
func (a *App) Run() error {
	_, err := a.program.Run()
	return err
}

// GetModel returns the current model state (for testing)
func (a *App) GetModel() *model.Model {
	if m, ok := a.program.Release().(*model.Model); ok {
		return m
	}
	return a.model
}

// SendCommand sends a command to the program (for testing)
func (a *App) SendCommand(cmd tea.Cmd) {
	if cmd != nil {
		go func() {
			if msg := cmd(); msg != nil {
				a.program.Send(msg)
			}
		}()
	}
}

// SendMessage sends a message to the program (for testing)
func (a *App) SendMessage(msg tea.Msg) {
	a.program.Send(msg)
}

// Quit gracefully shuts down the application
func (a *App) Quit() {
	a.program.Quit()
}

// Config represents application configuration
type Config struct {
	EnableDebug     bool
	EnableMouse     bool
	EnableAltScreen bool
	RefreshInterval time.Duration
	LogLevel        string
}

// DefaultConfig returns default application configuration
func DefaultConfig() Config {
	return Config{
		EnableDebug:     false,
		EnableMouse:     true,
		EnableAltScreen: true,
		RefreshInterval: 1 * time.Second,
		LogLevel:        "info",
	}
}

// NewAppWithConfig creates an application with custom configuration
func NewAppWithConfig(config Config) *App {
	m := model.NewModel()

	// Apply configuration to model
	settings := m.Settings()
	settings.Debug = config.EnableDebug
	settings.RefreshInterval = config.RefreshInterval
	m.SetSettings(settings)

	// Build program options based on config
	opts := []tea.ProgramOption{
		tea.WithOutput(os.Stdout),
		tea.WithInput(os.Stdin),
	}

	if config.EnableAltScreen {
		opts = append(opts, tea.WithAltScreen())
	}

	if config.EnableMouse {
		opts = append(opts, tea.WithMouseCellMotion())
	}

	// Create initial commands
	cmds := tea.Batch(
		commands.LoadSettings(""),
	)

	if config.EnableDebug {
		cmds = tea.Batch(cmds, func() tea.Msg {
			return messages.DebugToggleMsg{Enabled: true}
		})
	}

	program := tea.NewProgram(m, opts...)

	return &App{
		model:   &m,
		program: program,
	}
}

// Helper function to create app with environment-based config
func NewAppFromEnv() *App {
	config := DefaultConfig()

	// Read configuration from environment variables
	if os.Getenv("BRUMMER_DEBUG") == "true" {
		config.EnableDebug = true
	}

	if os.Getenv("BRUMMER_NO_MOUSE") == "true" {
		config.EnableMouse = false
	}

	if os.Getenv("BRUMMER_NO_ALTSCREEN") == "true" {
		config.EnableAltScreen = false
	}

	if os.Getenv("BRUMMER_LOG_LEVEL") != "" {
		config.LogLevel = os.Getenv("BRUMMER_LOG_LEVEL")
	}

	return NewAppWithConfig(config)
}

// Main entry point for the Redux/Elm TUI
func MainApp() error {
	app := NewAppFromEnv()

	if err := app.Run(); err != nil {
		return fmt.Errorf("failed to run Redux/Elm TUI: %w", err)
	}

	return nil
}