package harness

import (
	"encoding/json"
	"fmt"
	"testing"
	"time"
)

// TestTestReporter_ResultManagement tests the result management methods of TestReporter
func TestTestReporter_ResultManagement(t *testing.T) {
	reporter := newMockTestReporter()

	// Test initial state
	results := reporter.GetTestResults()
	if len(results) != 0 {
		t.Errorf("Expected initial results to be empty, got %d results", len(results))
	}

	// Test AddTestResult
	testResult1 := TestResult{
		TestID:    "test-1",
		Action:    "key_press",
		Actions:   []TestAction{{Type: ActionTypeKeyPress}},
		Status:    TestStatusPass,
		Duration:  time.Millisecond * 150,
		Timestamp: time.Now(),
		Metrics: TestMetrics{
			InputEvents:      1,
			StateValidations: 2,
			ViewChanges:      0,
			TotalDuration:    time.Millisecond * 150,
		},
	}

	if err := reporter.AddTestResult(testResult1); err != nil {
		t.Fatalf("AddTestResult failed: %v", err)
	}

	// Verify result was added
	results = reporter.GetTestResults()
	if len(results) != 1 {
		t.Errorf("Expected 1 result after adding, got %d", len(results))
	}

	if results[0].TestID != testResult1.TestID {
		t.Errorf("Expected test ID %s, got %s", testResult1.TestID, results[0].TestID)
	}

	// Test adding multiple results
	testResult2 := TestResult{
		TestID:    "test-2",
		Action:    "key_sequence",
		Actions:   []TestAction{{Type: ActionTypeKeySequence}, {Type: ActionTypeWait}},
		Status:    TestStatusFail,
		Duration:  time.Millisecond * 200,
		Timestamp: time.Now(),
		Error:     "validation failed",
		Metrics: TestMetrics{
			InputEvents:      2,
			StateValidations: 1,
			ViewChanges:      1,
			TotalDuration:    time.Millisecond * 200,
		},
	}

	if err := reporter.AddTestResult(testResult2); err != nil {
		t.Fatalf("AddTestResult failed for second result: %v", err)
	}

	results = reporter.GetTestResults()
	if len(results) != 2 {
		t.Errorf("Expected 2 results after adding second, got %d", len(results))
	}

	// Test GetTestResult
	retrievedResult, err := reporter.GetTestResult("test-1")
	if err != nil {
		t.Fatalf("GetTestResult failed: %v", err)
	}

	if retrievedResult.TestID != testResult1.TestID {
		t.Errorf("Expected retrieved test ID %s, got %s", testResult1.TestID, retrievedResult.TestID)
	}

	if retrievedResult.Status != testResult1.Status {
		t.Errorf("Expected retrieved status %s, got %s", testResult1.Status, retrievedResult.Status)
	}

	// Test GetTestResult with non-existent ID
	_, err = reporter.GetTestResult("non-existent")
	if err == nil {
		t.Error("Expected error when getting non-existent test result, but got nil")
	}

	expectedError := "test result not found: non-existent"
	if err.Error() != expectedError {
		t.Errorf("Expected error message '%s', got '%s'", expectedError, err.Error())
	}
}

// TestTestReporter_ReportGeneration tests the report generation methods
func TestTestReporter_ReportGeneration(t *testing.T) {
	reporter := newMockTestReporter()

	// Add test results for report generation
	testResults := []TestResult{
		{
			TestID:    "test-pass",
			Status:    TestStatusPass,
			Duration:  time.Millisecond * 100,
			Timestamp: time.Now().Add(-time.Minute),
		},
		{
			TestID:    "test-fail",
			Status:    TestStatusFail,
			Duration:  time.Millisecond * 150,
			Timestamp: time.Now().Add(-time.Second * 30),
		},
		{
			TestID:    "test-skip",
			Status:    TestStatusSkip,
			Duration:  time.Millisecond * 50,
			Timestamp: time.Now().Add(-time.Second * 10),
		},
	}

	for _, result := range testResults {
		if err := reporter.AddTestResult(result); err != nil {
			t.Fatalf("AddTestResult failed: %v", err)
		}
	}

	// Test GenerateReport
	report, err := reporter.GenerateReport()
	if err != nil {
		t.Fatalf("GenerateReport failed: %v", err)
	}

	// Verify report structure
	if report.GeneratedAt.IsZero() {
		t.Error("Expected GeneratedAt to be set, but it was zero")
	}

	if report.Format != ReportFormatJSON {
		t.Errorf("Expected report format %s, got %s", ReportFormatJSON, report.Format)
	}

	if len(report.TestResults) != 3 {
		t.Errorf("Expected 3 test results in report, got %d", len(report.TestResults))
	}

	// Verify summary in report
	if report.Summary.TotalTests != 3 {
		t.Errorf("Expected 3 total tests in summary, got %d", report.Summary.TotalTests)
	}

	if report.Summary.Passed != 1 {
		t.Errorf("Expected 1 passed test in summary, got %d", report.Summary.Passed)
	}

	if report.Summary.Failed != 1 {
		t.Errorf("Expected 1 failed test in summary, got %d", report.Summary.Failed)
	}

	if report.Summary.Skipped != 1 {
		t.Errorf("Expected 1 skipped test in summary, got %d", report.Summary.Skipped)
	}

	// Test GenerateSummary
	summary := reporter.GenerateSummary()
	if summary.TotalTests != 3 {
		t.Errorf("Expected 3 total tests in summary, got %d", summary.TotalTests)
	}

	if summary.Passed != 1 {
		t.Errorf("Expected 1 passed test, got %d", summary.Passed)
	}

	if summary.Failed != 1 {
		t.Errorf("Expected 1 failed test, got %d", summary.Failed)
	}

	if summary.Skipped != 1 {
		t.Errorf("Expected 1 skipped test, got %d", summary.Skipped)
	}

	if summary.TotalDuration != time.Millisecond*300 {
		t.Errorf("Expected total duration %v, got %v", time.Millisecond*300, summary.TotalDuration)
	}

	// Test that summary timestamp is recent
	if summary.LastExecution.IsZero() {
		t.Error("Expected LastExecution to be set, but it was zero")
	}

	// Test GenerateSummary with empty results
	emptyReporter := newMockTestReporter()
	emptySummary := emptyReporter.GenerateSummary()
	if emptySummary.TotalTests != 0 {
		t.Errorf("Expected 0 total tests for empty reporter, got %d", emptySummary.TotalTests)
	}

	if emptySummary.Passed != 0 || emptySummary.Failed != 0 || emptySummary.Skipped != 0 {
		t.Error("Expected all test counts to be 0 for empty reporter")
	}
}

// TestTestReporter_ExportReport tests the report export functionality
func TestTestReporter_ExportReport(t *testing.T) {
	reporter := newMockTestReporter()

	// Add a test result first
	testResult := TestResult{
		TestID:    "export-test",
		Status:    TestStatusPass,
		Duration:  time.Millisecond * 75,
		Timestamp: time.Now(),
	}
	if err := reporter.AddTestResult(testResult); err != nil {
		t.Fatalf("AddTestResult failed: %v", err)
	}

	// Test JSON export
	jsonData, err := reporter.ExportReport(ReportFormatJSON)
	if err != nil {
		t.Fatalf("ExportReport with JSON format failed: %v", err)
	}

	if len(jsonData) == 0 {
		t.Error("Expected non-empty JSON data, got empty slice")
	}

	// Verify JSON is valid
	var jsonReport map[string]interface{}
	if err := json.Unmarshal(jsonData, &jsonReport); err != nil {
		t.Errorf("Exported JSON is invalid: %v", err)
	}

	if format, ok := jsonReport["format"].(string); !ok || format != "json" {
		t.Errorf("Expected JSON format field to be 'json', got %v", jsonReport["format"])
	}

	// Test HTML export
	htmlData, err := reporter.ExportReport(ReportFormatHTML)
	if err != nil {
		t.Fatalf("ExportReport with HTML format failed: %v", err)
	}

	if len(htmlData) == 0 {
		t.Error("Expected non-empty HTML data, got empty slice")
	}

	expectedHTML := "Report in html format"
	if string(htmlData) != expectedHTML {
		t.Errorf("Expected HTML content '%s', got '%s'", expectedHTML, string(htmlData))
	}

	// Test XML export
	xmlData, err := reporter.ExportReport(ReportFormatXML)
	if err != nil {
		t.Fatalf("ExportReport with XML format failed: %v", err)
	}

	if len(xmlData) == 0 {
		t.Error("Expected non-empty XML data, got empty slice")
	}

	expectedXML := "Report in xml format"
	if string(xmlData) != expectedXML {
		t.Errorf("Expected XML content '%s', got '%s'", expectedXML, string(xmlData))
	}

	// Test JUnit export
	junitData, err := reporter.ExportReport(ReportFormatJUNIT)
	if err != nil {
		t.Fatalf("ExportReport with JUnit format failed: %v", err)
	}

	if len(junitData) == 0 {
		t.Error("Expected non-empty JUnit data, got empty slice")
	}

	expectedJUnit := "Report in junit format"
	if string(junitData) != expectedJUnit {
		t.Errorf("Expected JUnit content '%s', got '%s'", expectedJUnit, string(junitData))
	}

	// Test export with empty reporter
	emptyReporter := newMockTestReporter()
	emptyData, err := emptyReporter.ExportReport(ReportFormatJSON)
	if err != nil {
		t.Fatalf("ExportReport with empty reporter failed: %v", err)
	}

	if len(emptyData) == 0 {
		t.Error("Expected non-empty data from empty reporter, got empty slice")
	}
}

// TestTestReporter_Metrics tests the metrics calculation functionality
func TestTestReporter_Metrics(t *testing.T) {
	reporter := newMockTestReporter()

	// Test metrics with empty reporter
	metrics := reporter.CalculateMetrics()
	if metrics.InputEvents != 0 {
		t.Errorf("Expected 0 input events for empty reporter, got %d", metrics.InputEvents)
	}

	if metrics.StateValidations != 0 {
		t.Errorf("Expected 0 state validations for empty reporter, got %d", metrics.StateValidations)
	}

	if metrics.ViewChanges != 0 {
		t.Errorf("Expected 0 view changes for empty reporter, got %d", metrics.ViewChanges)
	}

	if metrics.TotalDuration != 0 {
		t.Errorf("Expected 0 total duration for empty reporter, got %v", metrics.TotalDuration)
	}

	// Test GetMetrics with empty reporter
	metrics = reporter.GetMetrics()
	if metrics.InputEvents != 0 {
		t.Errorf("Expected 0 input events from GetMetrics for empty reporter, got %d", metrics.InputEvents)
	}

	// Add test results with different metrics
	testResults := []TestResult{
		{
			TestID: "metrics-test-1",
			Actions: []TestAction{
				{Type: ActionTypeKeyPress},
				{Type: ActionTypeKeySequence},
			},
			Status:    TestStatusPass,
			Duration:  time.Millisecond * 100,
			Metrics: TestMetrics{
				InputEvents:      2,
				StateValidations: 3,
				ViewChanges:      1,
				TotalDuration:    time.Millisecond * 100,
			},
		},
		{
			TestID: "metrics-test-2",
			Actions: []TestAction{
				{Type: ActionTypeWait},
				{Type: ActionTypeValidate},
			},
			Status:    TestStatusPass,
			Duration:  time.Millisecond * 150,
			Metrics: TestMetrics{
				InputEvents:      2,
				StateValidations: 1,
				ViewChanges:      0,
				TotalDuration:    time.Millisecond * 150,
			},
		},
		{
			TestID: "metrics-test-3",
			Actions: []TestAction{
				{Type: ActionTypeKeyPress},
			},
			Status:    TestStatusFail, // Should not count for state validations in mock
			Duration:  time.Millisecond * 50,
			Metrics: TestMetrics{
				InputEvents:      1,
				StateValidations: 0,
				ViewChanges:      2,
				TotalDuration:    time.Millisecond * 50,
			},
		},
	}

	for _, result := range testResults {
		if err := reporter.AddTestResult(result); err != nil {
			t.Fatalf("AddTestResult failed: %v", err)
		}
	}

	// Test CalculateMetrics
	metrics = reporter.CalculateMetrics()
	if metrics.InputEvents != 5 { // 2 + 2 + 1 actions
		t.Errorf("Expected 5 total input events, got %d", metrics.InputEvents)
	}

	if metrics.StateValidations != 2 { // Only passing tests count in mock
		t.Errorf("Expected 2 state validations (passing tests only), got %d", metrics.StateValidations)
	}

	if metrics.ViewChanges != 3 { // 1 + 0 + 2 from test results
		t.Errorf("Expected 3 view changes, got %d", metrics.ViewChanges)
	}

	if metrics.TotalDuration != time.Millisecond*300 { // 100 + 150 + 50
		t.Errorf("Expected total duration %v, got %v", time.Millisecond*300, metrics.TotalDuration)
	}

	// Test GetMetrics - should return same as CalculateMetrics
	metricsFromGet := reporter.GetMetrics()
	if metricsFromGet.InputEvents != metrics.InputEvents {
		t.Errorf("GetMetrics input events (%d) != CalculateMetrics input events (%d)",
			metricsFromGet.InputEvents, metrics.InputEvents)
	}

	if metricsFromGet.StateValidations != metrics.StateValidations {
		t.Errorf("GetMetrics state validations (%d) != CalculateMetrics state validations (%d)",
			metricsFromGet.StateValidations, metrics.StateValidations)
	}

	if metricsFromGet.ViewChanges != metrics.ViewChanges {
		t.Errorf("GetMetrics view changes (%d) != CalculateMetrics view changes (%d)",
			metricsFromGet.ViewChanges, metrics.ViewChanges)
	}

	if metricsFromGet.TotalDuration != metrics.TotalDuration {
		t.Errorf("GetMetrics total duration (%v) != CalculateMetrics total duration (%v)",
			metricsFromGet.TotalDuration, metrics.TotalDuration)
	}
}

// TestTestReporter_ErrorConditions tests error conditions and edge cases
func TestTestReporter_ErrorConditions(t *testing.T) {
	reporter := newMockTestReporter()

	// Test GetTestResult with empty reporter
	_, err := reporter.GetTestResult("any-id")
	if err == nil {
		t.Error("Expected error when getting test result from empty reporter, but got nil")
	}

	// Test adding invalid test result (empty TestID)
	invalidResult := TestResult{
		TestID:   "", // Invalid empty ID
		Status:   TestStatusPass,
		Duration: time.Millisecond * 100,
	}

	// In mock implementation, this might succeed, but real implementation should validate
	err = reporter.AddTestResult(invalidResult)
	if err != nil {
		t.Logf("AddTestResult with empty TestID failed (expected in real implementation): %v", err)
	} else {
		t.Log("AddTestResult with empty TestID succeeded (mock behavior)")
	}

	// Test export with unsupported format
	_, err = reporter.ExportReport(ReportFormat("unsupported"))
	if err != nil {
		t.Logf("ExportReport with unsupported format failed (expected): %v", err)
	} else {
		// Mock might handle this gracefully
		t.Log("ExportReport with unsupported format succeeded (mock behavior)")
	}

	// Test GenerateReport with corrupted state
	// This is harder to test with mock, but we can verify it doesn't panic
	report, err := reporter.GenerateReport()
	if err != nil {
		t.Errorf("GenerateReport failed unexpectedly: %v", err)
	}

	if report.Summary.TotalTests < 0 {
		t.Error("Expected non-negative total test count")
	}
}

// TestTestReporter_ConcurrentAccess tests concurrent access to the reporter
func TestTestReporter_ConcurrentAccess(t *testing.T) {
	reporter := newMockTestReporter()

	// Test concurrent result addition
	done := make(chan bool, 5)
	numGoroutines := 5
	resultsPerGoroutine := 10

	for i := 0; i < numGoroutines; i++ {
		go func(goroutineID int) {
			defer func() { done <- true }()

			for j := 0; j < resultsPerGoroutine; j++ {
				testResult := TestResult{
					TestID:    fmt.Sprintf("concurrent-test-%d-%d", goroutineID, j),
					Actions:   []TestAction{{Type: ActionTypeKeyPress}}, // Add 1 action for each result
					Status:    TestStatusPass,
					Duration:  time.Millisecond * time.Duration(50+j),
					Timestamp: time.Now(),
				}

				if err := reporter.AddTestResult(testResult); err != nil {
					t.Errorf("AddTestResult failed in goroutine %d: %v", goroutineID, err)
					return
				}
			}
		}(i)
	}

	// Wait for all goroutines to complete
	for i := 0; i < numGoroutines; i++ {
		select {
		case <-done:
			// OK
		case <-time.After(time.Second * 10):
			t.Error("Timeout waiting for concurrent result addition to complete")
			return
		}
	}

	// Verify all results were added
	results := reporter.GetTestResults()
	expectedCount := numGoroutines * resultsPerGoroutine
	if len(results) != expectedCount {
		t.Errorf("Expected %d results after concurrent addition, got %d", expectedCount, len(results))
	}

	// Test concurrent read operations
	readDone := make(chan bool, 3)

	// Goroutine 1: Get all results
	go func() {
		defer func() { readDone <- true }()
		results := reporter.GetTestResults()
		if len(results) != expectedCount {
			t.Errorf("Concurrent read 1: Expected %d results, got %d", expectedCount, len(results))
		}
	}()

	// Goroutine 2: Get summary
	go func() {
		defer func() { readDone <- true }()
		summary := reporter.GenerateSummary()
		if summary.TotalTests != expectedCount {
			t.Errorf("Concurrent read 2: Expected %d total tests, got %d", expectedCount, summary.TotalTests)
		}
	}()

	// Goroutine 3: Get metrics
	go func() {
		defer func() { readDone <- true }()
		metrics := reporter.CalculateMetrics()
		if metrics.InputEvents != expectedCount { // Each result has 1 action by default
			t.Errorf("Concurrent read 3: Expected %d input events, got %d", expectedCount, metrics.InputEvents)
		}
	}()

	// Wait for all read operations to complete
	for i := 0; i < 3; i++ {
		select {
		case <-readDone:
			// OK
		case <-time.After(time.Second * 5):
			t.Error("Timeout waiting for concurrent read operations to complete")
			return
		}
	}
}

// TestTestReporter_RealImplementationNeeded verifies that this is a contract test
// and a real TestReporter implementation is still needed
func TestTestReporter_RealImplementationNeeded(t *testing.T) {
	t.Log("This is a contract test for the TestReporter interface")
	t.Log("Current implementation uses mock TestReporter for testing interface compliance")
	t.Log("A real TestReporter implementation is needed that:")
	t.Log("- Persists test results to storage")
	t.Log("- Generates detailed reports in multiple formats")
	t.Log("- Calculates accurate metrics for performance analysis")
	t.Log("- Provides export functionality for CI/CD integration")
	t.Log("- Handles large volumes of test results efficiently")

	// This test serves as a placeholder to remind developers that a real implementation is needed
	// When the real implementation is created, this test should be updated or removed
	t.Skip("Contract test complete - real TestReporter implementation required")
}