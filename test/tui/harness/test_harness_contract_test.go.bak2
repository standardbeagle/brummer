package harness

import (
	"fmt"
	"sync"
	"testing"
	"time"

	"github.com/charmbracelet/bubbletea"
)

// Test types and interfaces based on the API contract specification

// TestHarness defines the interface for TUI integration testing
type TestHarness interface {
	// Lifecycle management
	Initialize(config TestHarnessConfiguration) error
	Start() error
	Stop() error
	GetStatus() TestHarnessStatus

	// Test execution
	RunTest(testCase TestCase) TestResult
	RunTestSuite(testSuite TestSuite) TestSuiteResult

	// Component access
	GetInputSimulator() InputSimulator
	GetStateValidator() StateValidator
	GetTestReporter() TestReporter
}

// InputSimulator interface for simulating keyboard input
type InputSimulator interface {
	// Input generation
	GenerateKeySequence(action string) ([]tea.KeyMsg, error)
	SimulateKeyPress(key tea.KeyMsg) error
	SimulateKeySequence(sequence []tea.KeyMsg) error

	// Configuration
	SetKeyMappings(mappings []KeyMapping) error
	SetTimingDelay(delay time.Duration) error

	// State management
	GetCurrentSequence() []tea.KeyMsg
	ClearSequence() error
}

// StateValidator interface for validating TUI state
type StateValidator interface {
	// State capture and validation
	CaptureState(model interface{}) (StateSnapshot, error)
	ValidateTransition(from, to StateSnapshot) ValidationResult
	CompareStates(expected, actual StateSnapshot) ComparisonResult

	// Expected state management
	AddExpectedState(state ExpectedState) error
	ClearExpectedStates() error

	// Validation rules
	AddValidationRule(rule ValidationRule) error
	ValidateState(state StateSnapshot) []ValidationResult
}

// TestReporter interface for generating test reports
type TestReporter interface {
	// Result management
	AddTestResult(result TestResult) error
	GetTestResults() []TestResult
	GetTestResult(testID string) (TestResult, error)

	// Report generation
	GenerateReport() (Report, error)
	GenerateSummary() TestSummary
	ExportReport(format ReportFormat) ([]byte, error)

	// Metrics
	CalculateMetrics() TestMetrics
	GetMetrics() TestMetrics
}

// Data structures

type TestHarnessStatus int

const (
	TestHarnessStatusUninitialized TestHarnessStatus = iota
	TestHarnessStatusInitialized
	TestHarnessStatusStarted
	TestHarnessStatusStopped
	TestHarnessStatusError
)

type TestHarnessConfiguration struct {
	TestTimeout     time.Duration `json:"test_timeout"`
	KeyInputDelay   time.Duration `json:"key_input_delay"`
	StateValidation bool          `json:"state_validation"`
	ReportLevel     ReportLevel   `json:"report_level"`
	TestScope       TestScope     `json:"test_scope"`
}

type TestCase struct {
	ID              string         `json:"id"`
	Name            string         `json:"name"`
	Description     string         `json:"description"`
	Actions         []TestAction   `json:"actions"`
	ExpectedStates  []ExpectedState `json:"expected_states"`
	Preconditions   []string       `json:"preconditions"`
	Timeout         time.Duration  `json:"timeout"`
}

type TestAction struct {
	Type        ActionType     `json:"type"`
	Parameters  interface{}    `json:"parameters"`
	Description string         `json:"description"`
	Delay       time.Duration  `json:"delay"`
}

type ActionType string

const (
	ActionTypeKeyPress    ActionType = "key_press"
	ActionTypeKeySequence ActionType = "key_sequence"
	ActionTypeWait        ActionType = "wait"
	ActionTypeValidate    ActionType = "validate"
)

type ExpectedState struct {
	TriggerAction string        `json:"trigger_action"`
	ViewType      string        `json:"view_type"`
	Timeout       time.Duration `json:"timeout"`
	Properties    map[string]interface{} `json:"properties"`
}

type TestResult struct {
	TestID        string         `json:"test_id"`
	Action        string         `json:"action"`
	Actions       []TestAction   `json:"actions"`
	ExpectedState ExpectedState  `json:"expected_state"`
	ActualState   ActualState    `json:"actual_state"`
	Status        TestStatus     `json:"status"`
	Duration      time.Duration  `json:"duration"`
	Error         string         `json:"error,omitempty"`
	Timestamp     time.Time      `json:"timestamp"`
	Metrics       TestMetrics    `json:"metrics"`
}

type ActualState struct {
	ViewType    string                 `json:"view_type"`
	Properties  map[string]interface{} `json:"properties"`
	Timestamp   time.Time              `json:"timestamp"`
}

type TestStatus string

const (
	TestStatusPass   TestStatus = "pass"
	TestStatusFail   TestStatus = "fail"
	TestStatusError  TestStatus = "error"
	TestStatusSkip   TestStatus = "skip"
	TestStatusTimeout TestStatus = "timeout"
)

type TestSuite struct {
	Name         string    `json:"name"`
	Description  string    `json:"description"`
	TestCases    []string  `json:"test_cases"`
	Configuration TestHarnessConfiguration `json:"configuration"`
}

type TestSuiteResult struct {
	SuiteName   string        `json:"suite_name"`
	TestResults []TestResult  `json:"test_results"`
	Summary     TestSummary   `json:"summary"`
	Duration    time.Duration `json:"duration"`
	Status      TestStatus    `json:"status"`
}

type TestSummary struct {
	TotalTests    int           `json:"total_tests"`
	Passed        int           `json:"passed"`
	Failed        int           `json:"failed"`
	Skipped       int           `json:"skipped"`
	TotalDuration time.Duration `json:"total_duration"`
	LastExecution time.Time     `json:"last_execution"`
}

type TestMetrics struct {
	InputEvents      int           `json:"input_events"`
	StateValidations int           `json:"state_validations"`
	ViewChanges      int           `json:"view_changes"`
	TotalDuration    time.Duration `json:"total_duration"`
}

// Additional supporting types

type KeyMapping struct {
	Action string       `json:"action"`
	Keys   []tea.KeyMsg `json:"keys"`
}

type StateSnapshot struct {
	ViewType    string                 `json:"view_type"`
	Properties  map[string]interface{} `json:"properties"`
	Timestamp   time.Time              `json:"timestamp"`
	ModelState  interface{}            `json:"model_state"`
}

type ValidationResult struct {
	Valid    bool   `json:"valid"`
	Message  string `json:"message"`
	Field    string `json:"field,omitempty"`
	Expected interface{} `json:"expected,omitempty"`
	Actual   interface{} `json:"actual,omitempty"`
}

type ComparisonResult struct {
	Match       bool                    `json:"match"`
	Differences map[string]interface{}   `json:"differences"`
	Similarity  float64                 `json:"similarity"`
}

type ValidationRule struct {
	ID          string             `json:"id"`
	Name        string             `json:"name"`
	Description string             `json:"description"`
	Validator   ValidationFunction `json:"-"`
	Parameters  interface{}        `json:"parameters"`
}

type ValidationFunction func(state StateSnapshot) ValidationResult

type Report struct {
	Summary     TestSummary    `json:"summary"`
	TestResults []TestResult   `json:"test_results"`
	GeneratedAt time.Time      `json:"generated_at"`
	Format      ReportFormat   `json:"format"`
}

type ReportFormat string

const (
	ReportFormatJSON ReportFormat = "json"
	ReportFormatHTML ReportFormat = "html"
	ReportFormatXML  ReportFormat = "xml"
	ReportFormatJUNIT ReportFormat = "junit"
)

type ReportLevel string

const (
	ReportLevelMinimal ReportLevel = "minimal"
	ReportLevelStandard ReportLevel = "standard"
	ReportLevelDetailed ReportLevel = "detailed"
	ReportLevelVerbose ReportLevel = "verbose"
)

type TestScope string

const (
	TestScopeUnit    TestScope = "unit"
	TestScopeIntegration TestScope = "integration"
	TestScopeE2E     TestScope = "e2e"
)

// Mock implementation for contract testing
type mockTestHarness struct {
	status    TestHarnessStatus
	config    TestHarnessConfiguration
	inputSim  InputSimulator
	validator StateValidator
	reporter  TestReporter
}

func newMockTestHarness() *mockTestHarness {
	return &mockTestHarness{
		status: TestHarnessStatusUninitialized,
		inputSim: newMockInputSimulator(),
		validator: &mockStateValidator{},
		reporter: newMockTestReporter(),
	}
}

func (m *mockTestHarness) Initialize(config TestHarnessConfiguration) error {
	m.config = config
	m.status = TestHarnessStatusInitialized
	return nil
}

func (m *mockTestHarness) Start() error {
	if m.status != TestHarnessStatusInitialized {
		return fmt.Errorf("harness must be initialized before starting")
	}
	m.status = TestHarnessStatusStarted
	return nil
}

func (m *mockTestHarness) Stop() error {
	m.status = TestHarnessStatusStopped
	return nil
}

func (m *mockTestHarness) GetStatus() TestHarnessStatus {
	return m.status
}

func (m *mockTestHarness) RunTest(testCase TestCase) TestResult {
	return TestResult{
		TestID:    testCase.ID,
		Actions:   testCase.Actions,
		Status:    TestStatusPass,
		Duration:  time.Millisecond * 100,
		Timestamp: time.Now(),
	}
}

func (m *mockTestHarness) RunTestSuite(testSuite TestSuite) TestSuiteResult {
	return TestSuiteResult{
		SuiteName: testSuite.Name,
		Status:    TestStatusPass,
		Duration:  time.Second,
		Summary: TestSummary{
			TotalTests:    1,
			Passed:        1,
			Failed:        0,
			TotalDuration: time.Second,
		},
	}
}

func (m *mockTestHarness) GetInputSimulator() InputSimulator {
	return m.inputSim
}

func (m *mockTestHarness) GetStateValidator() StateValidator {
	return m.validator
}

func (m *mockTestHarness) GetTestReporter() TestReporter {
	return m.reporter
}

// Mock implementations for component interfaces
type mockInputSimulator struct {
	sequence []tea.KeyMsg
	delay    time.Duration
}

func newMockInputSimulator() *mockInputSimulator {
	return &mockInputSimulator{
		sequence: make([]tea.KeyMsg, 0),
	}
}

func (m *mockInputSimulator) GenerateKeySequence(action string) ([]tea.KeyMsg, error) {
	// Return a simple key sequence for testing
	return []tea.KeyMsg{{Type: tea.KeyRunes, Runes: []rune{'t', 'e', 's', 't'}}}, nil
}

func (m *mockInputSimulator) SimulateKeyPress(key tea.KeyMsg) error {
	m.sequence = append(m.sequence, key)
	return nil
}

func (m *mockInputSimulator) SimulateKeySequence(sequence []tea.KeyMsg) error {
	m.sequence = append(m.sequence, sequence...)
	return nil
}

func (m *mockInputSimulator) SetKeyMappings(mappings []KeyMapping) error {
	return nil
}

func (m *mockInputSimulator) SetTimingDelay(delay time.Duration) error {
	m.delay = delay
	return nil
}

func (m *mockInputSimulator) GetCurrentSequence() []tea.KeyMsg {
	return m.sequence
}

func (m *mockInputSimulator) ClearSequence() error {
	m.sequence = make([]tea.KeyMsg, 0)
	return nil
}

type mockStateValidator struct{}

func (m *mockStateValidator) CaptureState(model interface{}) (StateSnapshot, error) {
	return StateSnapshot{}, nil
}

func (m *mockStateValidator) ValidateTransition(from, to StateSnapshot) ValidationResult {
	return ValidationResult{Valid: true}
}

func (m *mockStateValidator) CompareStates(expected, actual StateSnapshot) ComparisonResult {
	return ComparisonResult{Match: true}
}

func (m *mockStateValidator) AddExpectedState(state ExpectedState) error {
	return nil
}

func (m *mockStateValidator) ClearExpectedStates() error {
	return nil
}

func (m *mockStateValidator) AddValidationRule(rule ValidationRule) error {
	return nil
}

func (m *mockStateValidator) ValidateState(state StateSnapshot) []ValidationResult {
	return []ValidationResult{{Valid: true}}
}

type mockTestReporter struct {
	mu      sync.RWMutex
	results []TestResult
}

func newMockTestReporter() *mockTestReporter {
	return &mockTestReporter{
		results: make([]TestResult, 0),
	}
}

func (m *mockTestReporter) AddTestResult(result TestResult) error {
	m.mu.Lock()
	defer m.mu.Unlock()
	m.results = append(m.results, result)
	return nil
}

func (m *mockTestReporter) GetTestResults() []TestResult {
	m.mu.RLock()
	defer m.mu.RUnlock()
	// Return a copy to avoid race conditions
	results := make([]TestResult, len(m.results))
	copy(results, m.results)
	return results
}

func (m *mockTestReporter) GetTestResult(testID string) (TestResult, error) {
	m.mu.RLock()
	defer m.mu.RUnlock()
	for _, result := range m.results {
		if result.TestID == testID {
			return result, nil
		}
	}
	return TestResult{}, fmt.Errorf("test result not found: %s", testID)
}

func (m *mockTestReporter) GenerateReport() (Report, error) {
	m.mu.RLock()
	results := make([]TestResult, len(m.results))
	copy(results, m.results)
	m.mu.RUnlock()

	return Report{
		Summary:     m.GenerateSummary(),
		TestResults: results,
		GeneratedAt: time.Now(),
		Format:      ReportFormatJSON,
	}, nil
}

func (m *mockTestReporter) GenerateSummary() TestSummary {
	m.mu.RLock()
	defer m.mu.RUnlock()

	summary := TestSummary{
		TotalTests:    len(m.results),
		LastExecution: time.Now(),
	}

	for _, result := range m.results {
		switch result.Status {
		case TestStatusPass:
			summary.Passed++
		case TestStatusFail:
			summary.Failed++
		case TestStatusSkip:
			summary.Skipped++
		}
		summary.TotalDuration += result.Duration
	}

	return summary
}

func (m *mockTestReporter) ExportReport(format ReportFormat) ([]byte, error) {
	_, err := m.GenerateReport()
	if err != nil {
		return nil, err
	}

	switch format {
	case ReportFormatJSON:
		return []byte(`{"format":"json","summary":{}}`), nil
	default:
		return []byte(fmt.Sprintf("Report in %s format", format)), nil
	}
}

func (m *mockTestReporter) CalculateMetrics() TestMetrics {
	m.mu.RLock()
	defer m.mu.RUnlock()

	metrics := TestMetrics{}

	for _, result := range m.results {
		metrics.InputEvents += len(result.Actions)
		metrics.TotalDuration += result.Duration
		metrics.ViewChanges += result.Metrics.ViewChanges
		if result.Status == TestStatusPass {
			metrics.StateValidations++
		}
	}

	return metrics
}

func (m *mockTestReporter) GetMetrics() TestMetrics {
	return m.CalculateMetrics()
}

// Contract Tests

// TestTestHarness_LifecycleManagement tests the lifecycle management methods
func TestTestHarness_LifecycleManagement(t *testing.T) {
	harness := newMockTestHarness()

	// Test initial status
	if status := harness.GetStatus(); status != TestHarnessStatusUninitialized {
		t.Errorf("Expected initial status to be Uninitialized, got %v", status)
	}

	// Test initialization
	config := TestHarnessConfiguration{
		TestTimeout:     time.Second * 30,
		KeyInputDelay:   time.Millisecond * 100,
		StateValidation: true,
		ReportLevel:     ReportLevelStandard,
		TestScope:       TestScopeIntegration,
	}

	if err := harness.Initialize(config); err != nil {
		t.Fatalf("Initialize failed: %v", err)
	}

	if status := harness.GetStatus(); status != TestHarnessStatusInitialized {
		t.Errorf("Expected status to be Initialized after Initialize(), got %v", status)
	}

	// Test start
	if err := harness.Start(); err != nil {
		t.Fatalf("Start failed: %v", err)
	}

	if status := harness.GetStatus(); status != TestHarnessStatusStarted {
		t.Errorf("Expected status to be Started after Start(), got %v", status)
	}

	// Test stop
	if err := harness.Stop(); err != nil {
		t.Fatalf("Stop failed: %v", err)
	}

	if status := harness.GetStatus(); status != TestHarnessStatusStopped {
		t.Errorf("Expected status to be Stopped after Stop(), got %v", status)
	}
}

// TestTestHarness_TestExecution tests the test execution methods
func TestTestHarness_TestExecution(t *testing.T) {
	harness := newMockTestHarness()

	// Initialize harness
	config := TestHarnessConfiguration{
		TestTimeout: time.Second * 30,
	}
	if err := harness.Initialize(config); err != nil {
		t.Fatalf("Initialize failed: %v", err)
	}

	// Test RunTest
	testCase := TestCase{
		ID:          "test-1",
		Name:        "Test Case 1",
		Description: "A test case for contract testing",
		Actions: []TestAction{
			{
				Type:        ActionTypeKeyPress,
				Parameters:  map[string]string{"key": "q"},
				Description: "Press q to quit",
			},
		},
		ExpectedStates: []ExpectedState{
			{
				TriggerAction: "key_press",
				ViewType:      "processes",
				Timeout:       time.Second,
			},
		},
		Timeout: time.Second * 10,
	}

	result := harness.RunTest(testCase)

	if result.TestID != testCase.ID {
		t.Errorf("Expected test ID %s, got %s", testCase.ID, result.TestID)
	}

	if result.Status != TestStatusPass {
		t.Errorf("Expected test status %s, got %s", TestStatusPass, result.Status)
	}

	if result.Duration <= 0 {
		t.Errorf("Expected positive duration, got %v", result.Duration)
	}

	// Test RunTestSuite
	testSuite := TestSuite{
		Name:        "Test Suite 1",
		Description: "A test suite for contract testing",
		TestCases:   []string{testCase.ID},
		Configuration: TestHarnessConfiguration{
			TestTimeout: time.Second * 60,
		},
	}

	suiteResult := harness.RunTestSuite(testSuite)

	if suiteResult.SuiteName != testSuite.Name {
		t.Errorf("Expected suite name %s, got %s", testSuite.Name, suiteResult.SuiteName)
	}

	if suiteResult.Status != TestStatusPass {
		t.Errorf("Expected suite status %s, got %s", TestStatusPass, suiteResult.Status)
	}

	if suiteResult.Summary.TotalTests != 1 {
		t.Errorf("Expected 1 total test, got %d", suiteResult.Summary.TotalTests)
	}

	if suiteResult.Summary.Passed != 1 {
		t.Errorf("Expected 1 passed test, got %d", suiteResult.Summary.Passed)
	}
}

// TestTestHarness_ComponentAccess tests the component access methods
func TestTestHarness_ComponentAccess(t *testing.T) {
	harness := newMockTestHarness()

	// Test GetInputSimulator
	inputSim := harness.GetInputSimulator()
	if inputSim == nil {
		t.Error("GetInputSimulator returned nil")
	}

	// Test that InputSimulator interface methods exist
	if _, err := inputSim.GenerateKeySequence("test"); err != nil {
		t.Errorf("GenerateKeySequence failed: %v", err)
	}

	if err := inputSim.SimulateKeyPress(tea.KeyMsg{}); err != nil {
		t.Errorf("SimulateKeyPress failed: %v", err)
	}

	if err := inputSim.SimulateKeySequence([]tea.KeyMsg{}); err != nil {
		t.Errorf("SimulateKeySequence failed: %v", err)
	}

	if err := inputSim.SetKeyMappings([]KeyMapping{}); err != nil {
		t.Errorf("SetKeyMappings failed: %v", err)
	}

	if err := inputSim.SetTimingDelay(time.Millisecond * 100); err != nil {
		t.Errorf("SetTimingDelay failed: %v", err)
	}

	sequence := inputSim.GetCurrentSequence()
	if sequence == nil {
		t.Error("GetCurrentSequence returned nil")
	}

	if err := inputSim.ClearSequence(); err != nil {
		t.Errorf("ClearSequence failed: %v", err)
	}

	// Test GetStateValidator
	validator := harness.GetStateValidator()
	if validator == nil {
		t.Error("GetStateValidator returned nil")
	}

	// Test that StateValidator interface methods exist
	model := struct{}{}
	if _, err := validator.CaptureState(model); err != nil {
		t.Errorf("CaptureState failed: %v", err)
	}

	snapshot := StateSnapshot{}
	transitionResult := validator.ValidateTransition(snapshot, snapshot)
	if !transitionResult.Valid {
		t.Errorf("ValidateTransition failed: %s", transitionResult.Message)
	}

	comparisonResult := validator.CompareStates(snapshot, snapshot)
	if !comparisonResult.Match {
		t.Errorf("CompareStates failed: match=%v", comparisonResult.Match)
	}

	expectedState := ExpectedState{}
	if err := validator.AddExpectedState(expectedState); err != nil {
		t.Errorf("AddExpectedState failed: %v", err)
	}

	if err := validator.ClearExpectedStates(); err != nil {
		t.Errorf("ClearExpectedStates failed: %v", err)
	}

	validationRule := ValidationRule{
		ID:   "test-rule",
		Name: "Test Rule",
	}
	if err := validator.AddValidationRule(validationRule); err != nil {
		t.Errorf("AddValidationRule failed: %v", err)
	}

	results := validator.ValidateState(snapshot)
	if len(results) == 0 {
		t.Error("ValidateState returned no results")
	}

	// Test GetTestReporter
	reporter := harness.GetTestReporter()
	if reporter == nil {
		t.Error("GetTestReporter returned nil")
	}

	// Test that TestReporter interface methods exist
	testResult := TestResult{
		TestID:    "test-1",
		Status:    TestStatusPass,
		Duration:  time.Millisecond * 100,
		Timestamp: time.Now(),
	}

	if err := reporter.AddTestResult(testResult); err != nil {
		t.Errorf("AddTestResult failed: %v", err)
	}

	testResults := reporter.GetTestResults()
	if len(testResults) == 0 {
		t.Error("GetTestResults returned no results")
	}

	if _, err := reporter.GetTestResult("test-1"); err != nil {
		t.Errorf("GetTestResult failed: %v", err)
	}

	if _, err := reporter.GenerateReport(); err != nil {
		t.Errorf("GenerateReport failed: %v", err)
	}

	summary := reporter.GenerateSummary()
	if summary.TotalTests == 0 {
		t.Error("GenerateSummary returned empty summary")
	}

	if _, err := reporter.ExportReport(ReportFormatJSON); err != nil {
		t.Errorf("ExportReport failed: %v", err)
	}

	metrics := reporter.CalculateMetrics()
	if metrics.InputEvents != 0 {
		t.Errorf("Expected 0 input events, got %d", metrics.InputEvents)
	}

	metrics = reporter.GetMetrics()
	if metrics.InputEvents != 0 {
		t.Errorf("Expected 0 input events from GetMetrics, got %d", metrics.InputEvents)
	}
}

// TestTestHarness_ErrorConditions tests error conditions and edge cases
func TestTestHarness_ErrorConditions(t *testing.T) {
	harness := newMockTestHarness()

	// Test starting without initialization
	if err := harness.Start(); err == nil {
		t.Error("Expected Start to fail when not initialized, but it succeeded")
	}

	// Test with invalid configuration
	invalidConfig := TestHarnessConfiguration{
		TestTimeout: 0, // Invalid timeout
	}

	if err := harness.Initialize(invalidConfig); err != nil {
		// This might succeed in mock but should fail in real implementation
		t.Logf("Initialize with invalid config failed (expected): %v", err)
	}

	// Test running test without proper initialization
	testCase := TestCase{
		ID: "test-invalid",
	}

	// This should work in mock but might fail in real implementation
	result := harness.RunTest(testCase)
	if result.TestID != testCase.ID {
		t.Errorf("Expected test ID %s, got %s", testCase.ID, result.TestID)
	}

	// Test component access after stop
	if err := harness.Initialize(TestHarnessConfiguration{}); err != nil {
		t.Fatalf("Initialize failed: %v", err)
	}

	if err := harness.Start(); err != nil {
		t.Fatalf("Start failed: %v", err)
	}

	if err := harness.Stop(); err != nil {
		t.Fatalf("Stop failed: %v", err)
	}

	// Components should still be accessible after stop
	inputSim := harness.GetInputSimulator()
	if inputSim == nil {
		t.Error("GetInputSimulator returned nil after stop")
	}

	validator := harness.GetStateValidator()
	if validator == nil {
		t.Error("GetStateValidator returned nil after stop")
	}

	reporter := harness.GetTestReporter()
	if reporter == nil {
		t.Error("GetTestReporter returned nil after stop")
	}
}

// TestTestHarness_ConcurrentAccess tests concurrent access to the harness
func TestTestHarness_ConcurrentAccess(t *testing.T) {
	harness := newMockTestHarness()

	// Initialize harness
	config := TestHarnessConfiguration{
		TestTimeout: time.Second * 30,
	}
	if err := harness.Initialize(config); err != nil {
		t.Fatalf("Initialize failed: %v", err)
	}

	// Test concurrent component access
	done := make(chan bool, 3)

	// Goroutine 1: Access InputSimulator
	go func() {
		defer func() { done <- true }()
		inputSim := harness.GetInputSimulator()
		if inputSim == nil {
			t.Error("GetInputSimulator returned nil in concurrent access")
			return
		}
		if err := inputSim.SetTimingDelay(time.Millisecond * 50); err != nil {
			t.Errorf("SetTimingDelay failed in concurrent access: %v", err)
		}
	}()

	// Goroutine 2: Access StateValidator
	go func() {
		defer func() { done <- true }()
		validator := harness.GetStateValidator()
		if validator == nil {
			t.Error("GetStateValidator returned nil in concurrent access")
			return
		}
		snapshot := StateSnapshot{}
		results := validator.ValidateState(snapshot)
		if len(results) == 0 {
			t.Error("ValidateState returned no results in concurrent access")
		}
	}()

	// Goroutine 3: Access TestReporter
	go func() {
		defer func() { done <- true }()
		reporter := harness.GetTestReporter()
		if reporter == nil {
			t.Error("GetTestReporter returned nil in concurrent access")
			return
		}
		summary := reporter.GenerateSummary()
		if summary.TotalTests != 0 {
			t.Errorf("Expected 0 total tests, got %d in concurrent access", summary.TotalTests)
		}
	}()

	// Wait for all goroutines to complete
	for i := 0; i < 3; i++ {
		select {
		case <-done:
			// OK
		case <-time.After(time.Second * 5):
			t.Error("Timeout waiting for concurrent access to complete")
			break
		}
	}
}

