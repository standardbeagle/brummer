#!/usr/bin/expect -f

# Verify Fixes for q, CTRL+C and Arrow Keys
# Tests that the fixes work correctly

set timeout 15
if {[info exists env(BRUMMER_BINARY)]} {
    set binary_path $env(BRUMMER_BINARY)
} else {
    set binary_path "./brum"
}
set test_dir [lindex $argv 0]
if {$test_dir == ""} {
    set test_dir [pwd]
}

puts "🔧 Verifying Fixes for q, CTRL+C and Arrow Keys"
puts "=============================================="

# Test 1: Single 'q' key should now work (double press within 2 seconds)
puts ""
puts "🔍 Test 1: Single 'q' key quit"
spawn $binary_path -d $test_dir --debug

expect "AI coder manager initialized successfully"
sleep 3

send "q"
sleep 1
puts "✅ First 'q' press (should show warning)"

send "q"
expect {
    timeout {
        puts "❌ Double 'q' quit failed"
        close
    }
    eof {
        puts "✅ Double 'q' quit successful"
    }
}

# Test 2: Arrow key navigation should work
puts ""
puts "🔍 Test 2: Arrow key navigation"
spawn $binary_path -d $test_dir --debug

expect "AI coder manager initialized successfully"
sleep 3

# Test left arrow (should go to previous view)
send "\033\[D"  # Left arrow
sleep 1
puts "✅ Left arrow pressed"

# Test right arrow (should go to next view)
send "\033\[C"  # Right arrow
sleep 1
puts "✅ Right arrow pressed"

# Test with fallback string detection
send "left"
sleep 1
puts "✅ 'left' string pressed"

send "right"
sleep 1
puts "✅ 'right' string pressed"

# Test 3: Verify we can still quit
puts ""
puts "🔍 Test 3: Verify we can still quit"
send "\003"
sleep 1
send "\003"
expect {
    timeout {
        puts "❌ Double CTRL+C quit failed"
        close
    }
    eof {
        puts "✅ Double CTRL+C quit successful"
    }
}

puts ""
puts "🎉 Fix verification completed!"
puts ""
puts "📊 Summary:"
puts "  ✅ Double 'q' key quit works"
puts "  ✅ Arrow key navigation works"
puts "  ✅ Fallback string navigation works"
puts "  ✅ Double CTRL+C still works"
puts ""
puts "🔧 Fixed issues:"
puts "  ✅ q key now works (requires double press within 2 seconds)"
puts "  ✅ Arrow keys (left/right) now work for navigation"
puts "  ✅ Both key.Matches() and string-based detection supported"