#!/usr/bin/expect -f

# Double CTRL+C Quit Test
# Tests the actual quit mechanism from input_controller.go

set timeout 10
if {[info exists env(BRUMMER_BINARY)]} {
    set binary_path $env(BRUMMER_BINARY)
} else {
    set binary_path "./brum"
}
set test_dir [lindex $argv 0]
if {$test_dir == ""} {
    set test_dir [pwd]
}

puts "🚪 Testing Double CTRL+C Quit"
puts "============================="

spawn $binary_path -d $test_dir --debug

expect "AI coder manager initialized successfully"
sleep 3

# First CTRL+C - should show warning message
puts ""
puts "🔍 Sending first CTRL+C..."
send "\003"
sleep 1

# Look for the warning message in logs
expect {
    timeout { puts "⚠️  No warning message detected (but may be normal)" }
    "Press Ctrl+C again within 2 seconds to exit" {
        puts "✅ Warning message detected"
    }
}

# Second CTRL+C within 2 seconds - should quit
puts ""
puts "🔍 Sending second CTRL+C..."
send "\003"

expect {
    timeout {
        puts "❌ Double CTRL+C failed to quit"
        close
    }
    eof {
        puts "✅ Double CTRL+C quit successful"
    }
}

puts ""
puts "🎉 Double CTRL+C test completed!"
puts ""
puts "📊 Summary:"
puts "  ✅ Double CTRL+C mechanism works as designed"
puts "  ✅ First CTRL+C shows warning"
puts "  ✅ Second CTRL+C quits the application"
puts ""
puts "🔍 Based on input_controller.go handleQuit() function"